# ─────────────────────────────────────────────────────────────
# PitchMoment configuration. Copy to .env.local and fill in.
# ─────────────────────────────────────────────────────────────

# Which provider to use: fal | replicate | runway | mock
# Leave empty to auto-pick the first provider that has a key (fal → replicate → runway),
# falling back to "mock" (no AI, returns a demo clip) when no key is set.
VIDEO_PROVIDER=

# ── fal.ai ───────────────────────────────────────────────────
# https://fal.ai/dashboard/keys
FAL_KEY=
# Any fal image-to-video endpoint that accepts { prompt, image_url, duration } works.
FAL_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video

# ── Replicate ────────────────────────────────────────────────
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_MODEL=kwaivgi/kling-v2.1
# Name of the model's input field that takes the starting image
# (kling-v2.x: start_image, wan-video models: image)
REPLICATE_IMAGE_FIELD=start_image

# ── Runway ───────────────────────────────────────────────────
# https://dev.runwayml.com
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4_turbo
# Vertical 9:16 for social. Check your model's supported ratios.
RUNWAY_RATIO=720:1280

# ── App settings ─────────────────────────────────────────────
# Clip length in seconds (most models support 5 or 10)
CLIP_SECONDS=5
# Download finished clips to .data/videos so links don't expire
PERSIST_VIDEOS=true
# Max generations per IP per hour (cost guard). 0 = unlimited.
RATE_LIMIT_PER_HOUR=10
